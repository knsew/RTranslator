<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration dialog for the custom LLM translation mode (fork addition).
     The server address, model id and API key of an OpenAI-compatible endpoint,
     plus the thinking and streaming switches. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/llm_base_url"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLlmBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:hint="@string/llm_base_url_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/llm_model"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLlmModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:hint="@string/llm_model_hint"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/llm_api_key"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLlmApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:hint="@string/llm_api_key_hint"
            android:inputType="textPassword"
            android:singleLine="true" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLlmThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/llm_thinking" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/llm_thinking_description"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLlmStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/llm_stream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/llm_stream_description"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonTestLlm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/llm_test_connection" />

    </LinearLayout>
</ScrollView>
